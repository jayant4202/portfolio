# Security headers for static files (Cloudflare Pages).
# Pages Functions responses (HTML pages routed through functions/_middleware.js) get the same baseline
# from lib/edge/security-headers.js — build.sh fails if the two ever drift apart.
# To embed a hosted prototype later, change frame-src 'none' to that host in BOTH files.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'report-sample'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests; report-uri /api/report; report-to csp
  Reporting-Endpoints: csp="/api/report"
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Origin-Agent-Cluster: ?1

# Caching. build.sh copies every CSS, JS and image file to /assets/h/<name>.<content-hash>.<ext> and
# points all pages there. A hashed URL always means exactly one version of a file, so browsers may
# keep it for a year without re-checking. The original paths stay available for direct links, with
# a normal 1-day cache. Video and PDFs (linked directly from elsewhere) also use a 1-day cache.
/assets/h/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=86400

/assets/js/*
  Cache-Control: public, max-age=86400

/assets/img/*
  Cache-Control: public, max-age=86400

/assets/video/*
  Cache-Control: public, max-age=86400

# PDFs open in the browser's built-in viewer; the page CSP isn't needed there and can break the viewer.
/assets/docs/*
  Cache-Control: public, max-age=86400
  ! Content-Security-Policy

/assets/Jayant-Goswami-Resume.pdf
  Cache-Control: public, max-age=86400
  ! Content-Security-Policy
  Content-Disposition: attachment; filename="Jayant-Goswami-Resume.pdf"
